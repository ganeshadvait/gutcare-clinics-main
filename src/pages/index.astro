---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import WhyUs from '../components/WhyUs.astro';
import Doctors from '../components/Doctors.astro';
import PatientJourney from '../components/PatientJourney.astro';
import Reviews from '../components/Reviews.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Clinic from '../components/Clinic.astro';
import BlogSection from '../components/BlogSection.astro';
import Faq from '../components/Faq.astro';
---

<Layout
  title="Colorectal & Laparoscopic Clinic in Bangalore | GutCare"
  description="Colorectal and laparoscopic care in Bangalore from an expert surgeon. Laser piles, fistula and fissure treatment. Book a consultation."
>
  <Hero />
  <Treatments />
  <WhyUs />
  <Doctors />
  <PatientJourney />
  <Reviews />
  <CtaBanner />
  <Clinic />
  <BlogSection server:defer>
    <div slot="fallback" class="min-h-[40rem]" aria-hidden="true"></div>
  </BlogSection>
  <Faq />
</Layout>
