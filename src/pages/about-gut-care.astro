---
import { HeartHandshake, Microscope, BadgeIndianRupee, Clock } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhyUs from '../components/WhyUs.astro';
import Doctors from '../components/Doctors.astro';
import Clinic from '../components/Clinic.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import exterior from '../assets/clinic/exterior.png';

const values = [
  { icon: HeartHandshake, title: 'Patient first', text: 'Care that respects your comfort, privacy and dignity at every step.' },
  { icon: Microscope, title: 'Accurate diagnosis', text: 'The right treatment starts with understanding the real cause of your problem.' },
  { icon: BadgeIndianRupee, title: 'Transparent & fair', text: 'Clear advice and cost estimates upfront, with help on insurance.' },
  { icon: Clock, title: 'Always available', text: 'A 24x7 emergency facility for when you need us most.' },
];

const faqs = [
  {
    q: 'Where is GutCare Clinics located in Bangalore?',
    a: 'GutCare Clinics is on 13th ‘H’ Main, HAL 2nd Stage, Indiranagar, Bengaluru 560008. It is easy to reach from nearby areas such as Domlur, Old Airport Road, CMH Road and Koramangala.',
  },
  {
    q: 'What conditions do you treat?',
    a: 'We treat piles, anal fissures, anal fistula, hernia, gallstones, appendicitis, acid reflux (GERD), constipation and colorectal cancer.',
  },
  {
    q: 'Do you provide emergency care?',
    a: 'Yes. GutCare has a 24x7 emergency facility.',
  },
  {
    q: 'Do you help with insurance and cost estimates?',
    a: 'Yes. We share clear cost estimates upfront and assist with insurance.',
  },
  {
    q: 'Do you treat international patients?',
    a: 'Yes. We help with treatment planning, cost estimates and stay for patients from other cities and countries.',
  },
];
---

<Layout
  title="About GutCare Clinics | Colorectal & Laser Surgery Bangalore"
  description="Trusted colorectal & laparoscopic clinic in Indiranagar, Bangalore. 25,000+ surgeries, laser care for piles, fistula, hernia. 24x7 emergency."
>
  <PageHero
    eyebrow="About GutCare"
    title="About GutCare Clinics: *Expert Gut & Colorectal Care* in Bangalore"
    subtitle="GutCare Clinics is a trusted colorectal and laparoscopic surgery hospital in Indiranagar, Bangalore. Our experienced surgeons combine accurate diagnosis with modern minimally invasive treatment under one roof, with comfort, privacy and dignity at every step."
    breadcrumbs={[{ label: 'About' }]}
    source="about-page"
    image={exterior}
    imageAlt="GutCare Clinics building in Indiranagar, Bengaluru"
    facts={[
      { label: 'In healthcare', value: '30 years' },
      { label: 'Surgeries done', value: '25,000+' },
      { label: 'Patients treated', value: '1 Lakh+' },
      { label: 'Emergency care', value: '24x7' },
    ]}
  />

  <!-- Story -->
  <section class="py-10 sm:py-14">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="heading-xl">Who <span class="highlight">we are</span></h2>
      </div>
      <div class="space-y-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        <p>
          GutCare Clinics is a colorectal hospital in Indiranagar, Bangalore, providing advanced laser treatment for piles,
          fistula, fissures, hernia and gallbladder stones, and for laparoscopic surgeries. We also treat acid reflux,
          constipation and other digestive disorders.
        </p>
        <p>
          Almost everyone has digestive problems at some point. We provide expert care across digestive disorders, from
          diagnosis to treatment, with a 24x7 emergency facility. Our doctors have international experience, and we have
          treated patients from different countries.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-slate-50 py-10 sm:py-14">
    <div class="container-x">
      <SectionHeading eyebrow="What we stand for" title="Care built on *trust*" />
      <ul class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map(({ icon: Icon, title, text }) => (
            <li class="text-center">
              <Icon class="mx-auto h-9 w-9 text-brand-500" stroke-width={1.6} />
              <h3 class="mt-4 font-bold text-slate-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <WhyUs />
  <Doctors />
  <Clinic />
  <Faq faqs={faqs} />
  <CtaBanner />
</Layout>
