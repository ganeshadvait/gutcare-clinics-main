---
import { CalendarCheck, Award, Users, Clock, ShieldCheck } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import CallOrWhatsApp from './CallOrWhatsApp.astro';
import { site, whatsappLink } from '../data/site';
import DoctorPortrait from './DoctorPortrait.astro';

const trust = [
  { icon: Award, value: '30 Years', label: 'in healthcare' },
  { icon: ShieldCheck, value: '25,000+', label: 'surgeries done' },
  { icon: Users, value: '1 Lakh+', label: 'patients treated' },
  { icon: Clock, value: '24x7', label: 'emergency care' },
];
---

<section id="book" class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-leaf-50/60">
  <!-- Soft brand shape behind the portrait -->
  <div class="pointer-events-none absolute -right-48 top-10 hidden h-[44rem] w-[44rem] rounded-full bg-brand-100/70 lg:block" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-12 pt-10 sm:pt-14 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:pt-16">
    <!-- Copy + form -->
    <div class="lg:pb-14">
      <h1 class="text-3xl font-extrabold leading-[1.12] tracking-tight sm:text-5xl lg:text-[3rem]">
        <span class="highlight">Colorectal &amp; Laparoscopic</span> Care in Bangalore
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Get advanced laser treatment for piles, fistula and fissures, and laparoscopic surgery for hernia and gallstones
        at GutCare Clinics, Bangalore. Led by an experienced colorectal surgeon, we help you understand your options and
        plan the next step in your care.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <button type="button" class="btn btn-leaf !px-8 !py-4 text-base" data-open-form="hero">
          <CalendarCheck class="h-5 w-5" /> Book an Appointment
        </button>
        <CallOrWhatsApp
          class="btn btn-ghost !px-6 !py-4 text-base"
          callLabel={`Call ${site.phone}`}
          callIconClass="h-5 w-5 text-brand-500"
          waIconClass="h-5 w-5 text-[#25D366]"
        />
      </div>

      <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
        <span class="inline-flex items-center gap-1.5"><ShieldCheck class="h-4 w-4 text-leaf-500" /> Quick callback from our care team</span>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-leaf-600 hover:underline lg:hidden">
          <WhatsAppIcon class="h-4 w-4" /> Or WhatsApp us
        </a>
      </p>
    </div>

    <!-- Doctor portrait, standing on the trust-strip line -->
    <DoctorPortrait />
  </div>

  <!-- Trust strip -->
  <div class="container-x relative pb-12">
    <dl class="grid grid-cols-2 gap-y-6 border-t border-slate-200/70 pt-8 lg:grid-cols-4 lg:divide-x lg:divide-slate-200/70">
      {
        trust.map(({ icon: Icon, value, label }) => (
          <div class="flex items-center gap-3 lg:justify-center">
            <Icon class="h-7 w-7 shrink-0 text-brand-500" stroke-width={1.75} />
            <div>
              <dt class="sr-only">{label}</dt>
              <dd class="text-xl font-extrabold text-slate-900 sm:text-2xl">{value}</dd>
              <dd class="text-xs text-slate-500 sm:text-sm">{label}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>

