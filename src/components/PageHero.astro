---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CalendarCheck, Phone, ChevronRight } from '@lucide/astro';
import { site } from '../data/site';

interface Props {
  eyebrow: string;
  /** Wrap the words to emphasise in *asterisks*. */
  title: string;
  subtitle: string;
  /** Trail after "Home", e.g. [{ label: 'Treatments', href: '/#treatments' }, { label: 'Hernia' }]. */
  breadcrumbs: { label: string; href?: string }[];
  /** Lead source recorded when the Book Appointment button opens the popup. */
  source: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** 'cutout' = transparent portrait on a brand circle; 'photo' = rounded photograph. */
  imageStyle?: 'cutout' | 'photo';
  facts?: { label: string; value: string }[];
  footnote?: string;
}

const { eyebrow, title, subtitle, breadcrumbs, source, image, imageAlt = '', imageStyle = 'photo', facts, footnote } = Astro.props;
const parts = title.split('*').map((text, i) => ({ text, highlight: i % 2 === 1 }));
const trail = [{ label: 'Home', href: '/' }, ...breadcrumbs];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, Astro.site).toString() } : {}),
  })),
};
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-leaf-50/60">
  <div class="pointer-events-none absolute -right-40 -top-24 hidden h-[34rem] w-[34rem] rounded-full bg-brand-100/60 lg:block" aria-hidden="true"></div>

  <div
    class:list={[
      'container-x relative grid items-center gap-10 pt-8 sm:pt-10',
      image ? 'lg:grid-cols-[1.2fr_1fr] lg:gap-14' : '',
      image && imageStyle === 'cutout' ? 'pb-0' : 'pb-12 sm:pb-16',
    ]}
  >
    <div class:list={[!image && 'max-w-3xl', image && imageStyle === 'cutout' && 'pb-12 sm:pb-16']}>
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1 text-xs text-slate-500 sm:text-sm">
          {
            trail.map((c, i) => (
              <li class="flex items-center gap-1">
                {i > 0 && <ChevronRight class="h-3.5 w-3.5 text-slate-300" />}
                {c.href && i < trail.length - 1 ? (
                  <a href={c.href} class="hover:text-brand-600">{c.label}</a>
                ) : (
                  <span aria-current="page" class="font-medium text-slate-700">{c.label}</span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <span class="eyebrow mt-6 bg-white">
        <span class="h-1.5 w-1.5 rounded-full bg-leaf-400" aria-hidden="true"></span>
        {eyebrow}
      </span>
      <h1 class="mt-5 text-3xl font-extrabold leading-[1.12] tracking-tight text-balance sm:text-5xl">
        {parts.map((p) => (p.highlight ? <span class="highlight">{p.text}</span> : p.text))}
      </h1>
      <p class="lead mt-5 max-w-2xl">{subtitle}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <button type="button" class="btn btn-leaf !px-7 !py-3.5 text-base" data-open-form={source}>
          <CalendarCheck class="h-5 w-5" /> Book Appointment
        </button>
        <a href={site.phoneHref} class="btn btn-ghost !px-6 !py-3.5 text-base">
          <Phone class="h-5 w-5 text-brand-500" /> {site.phone}
        </a>
      </div>
    </div>

    {
      image && imageStyle === 'cutout' && (
        <div class="relative mx-auto w-full max-w-sm self-end">
          <div class="absolute bottom-0 left-1/2 aspect-square w-[86%] -translate-x-1/2 rounded-full bg-gradient-to-br from-brand-400 via-brand-500 to-brand-700" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 18rem, 60vw"
            class="relative mx-auto h-auto max-h-[24rem] w-auto drop-shadow-2xl sm:max-h-[28rem]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    {
      image && imageStyle === 'photo' && (
        <div class="relative">
          <div class="absolute -inset-3 -z-0 rotate-2 rounded-[2rem] bg-gradient-to-br from-brand-200 to-leaf-200" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="relative aspect-[4/3] w-full rounded-[2rem] object-cover shadow-xl"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>

  {
    facts && facts.length > 0 && (
      <div class="container-x relative pb-10">
        <dl class:list={['grid grid-cols-2 gap-y-6 border-t border-slate-200/70 pt-8', facts.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3', 'lg:divide-x lg:divide-slate-200/70']}>
          {facts.map((f) => (
            <div class="lg:px-6 lg:first:pl-0">
              <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.label}</dt>
              <dd class="mt-1 text-lg font-extrabold text-slate-900 sm:text-xl">{f.value}</dd>
            </div>
          ))}
        </dl>
        {footnote && <p class="mt-4 text-xs text-slate-500">{footnote}</p>}
      </div>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</section>
