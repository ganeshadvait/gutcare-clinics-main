---
import { ArrowRight, Lock, CircleCheck } from '@lucide/astro';
import { treatments } from '../data/site';

interface Props {
  source: string;
  title?: string;
  titleId?: string;
  subtitle?: string;
  withTreatment?: boolean;
  /** Single-row layout (name | phone | submit) for wide placements such as the hero. */
  inline?: boolean;
}

const {
  source,
  title = 'Book a Consultation',
  titleId,
  subtitle = 'Share your details and our care team will call you back shortly.',
  withTreatment = false,
  inline = false,
} = Astro.props;

const uid = `lead-${source}`;
const label = inline ? 'sr-only' : 'mb-1.5 block text-sm font-medium text-slate-700';
const field =
  'block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:border-brand-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-100 aria-invalid:border-red-400';
---

<form
  class:list={[
    'lead-form bg-white shadow-2xl shadow-brand-900/15 ring-1 ring-slate-100',
    inline ? 'rounded-3xl p-5 sm:p-6' : 'rounded-3xl p-6 sm:p-8',
  ]}
  data-source={source}
  novalidate
>
  <div data-fields>
    <h2 id={titleId} class:list={['font-bold', inline ? 'text-lg' : 'text-xl sm:text-2xl']}>{title}</h2>
    <p class="mt-1 text-sm text-slate-500">{subtitle}</p>

    <div class:list={[inline ? 'mt-4 grid gap-3 sm:grid-cols-[1fr_1.15fr_auto] sm:items-start' : 'mt-6 space-y-4']}>
      <div>
        <label for={`${uid}-name`} class={label}>Full name</label>
        <input
          id={`${uid}-name`}
          name="name"
          type="text"
          autocomplete="name"
          required
          placeholder="Enter your name"
          class={field}
        />
        <p class="mt-1 hidden text-xs text-red-500" data-error="name">Please enter your name.</p>
      </div>

      <div>
        <label for={`${uid}-phone`} class={label}>Mobile number</label>
        <div class="flex rounded-xl border border-slate-200 bg-slate-50 focus-within:border-brand-400 focus-within:bg-white focus-within:ring-4 focus-within:ring-brand-100 has-aria-invalid:border-red-400">
          <span class="flex items-center border-r border-slate-200 pl-4 pr-3 text-sm font-semibold text-slate-600">+91</span>
          <input
            id={`${uid}-phone`}
            name="phone"
            type="tel"
            inputmode="numeric"
            autocomplete="tel-national"
            required
            maxlength="10"
            placeholder={inline ? "Mobile number" : "10-digit mobile number"}
            class="block w-full min-w-0 rounded-r-xl bg-transparent px-3 py-3 text-slate-900 placeholder:text-slate-400 focus:outline-none"
          />
        </div>
        <p class="mt-1 hidden text-xs text-red-500" data-error="phone">Enter a valid 10-digit mobile number.</p>
      </div>

      {
        withTreatment && (
          <div>
            <label for={`${uid}-treatment`} class="mb-1.5 block text-sm font-medium text-slate-700">
              Concern <span class="font-normal text-slate-400">(optional)</span>
            </label>
            <select id={`${uid}-treatment`} name="treatment" class={field}>
              <option value="">Select a concern</option>
              {treatments.map((t) => (
                <option value={t.name}>{t.name}</option>
              ))}
              <option value="Other">Other / Not sure</option>
            </select>
          </div>
        )
      }

      <button type="submit" class:list={['btn btn-leaf w-full text-base', inline ? '!py-3 sm:w-auto sm:px-8' : '!py-3.5']}>
        <span data-label>Submit</span>
        <ArrowRight class="h-5 w-5" />
      </button>

      <p class="hidden text-center text-xs text-red-500 sm:col-span-full" data-error="submit" role="alert">
        Sorry, something went wrong. Please call us at +91 84315 50550.
      </p>

      <p class:list={['flex items-center gap-1.5 text-xs text-slate-500 sm:col-span-full', inline ? 'justify-start' : 'justify-center']}>
        <Lock class="h-3.5 w-3.5" /> Your details are kept 100% confidential
      </p>
    </div>
  </div>

  <div class="hidden py-8 text-center" data-success role="status" aria-live="polite">
    <CircleCheck class="mx-auto h-14 w-14 text-leaf-500" />
    <p class="mt-4 text-xl font-bold text-slate-900">Thank you!</p>
    <p class="mt-1 text-sm text-slate-500">Our care coordinator will call you shortly.</p>
  </div>
</form>

<script>
  // Lead integrations carried over from the previous site.
  const ZOHO_URL = 'https://xiu1oo4uqc.execute-api.ap-south-1.amazonaws.com/Prod/create-lead';
  const ZAPIER_URL = 'https://hooks.zapier.com/hooks/catch/20814971/281t3lc/';
  const SHEET_URL = 'https://sheetdb.io/api/v1/goink9rv5f9tp';

  type LeadData = Record<string, string>;

  function buildLeadData(name: string, phone: string): LeadData {
    const params = new URLSearchParams(location.search);
    const get = (k: string) => params.get(k) || '';
    return {
      Last_Name: name,
      Phone: phone,
      Form_Type: 'Book an Appointment',
      Lead_Source: 'Website Form',
      Page_URL: location.href,
      clid: [get('gclid'), get('fbclid')].filter(Boolean).join('|'),
      UTM_Term: get('utm_term'),
      UTM_Content: get('utm_content'),
      UTM_Medium: get('utm_medium'),
      UTM_Campaign: get('utm_campaign'),
      UTM_Source: get('utm_source'),
      UTM_Platform: get('utm_platform'),
      UTM_Device: get('utm_device'),
    };
  }

  async function sendToZoho(lead: LeadData): Promise<boolean> {
    try {
      const res = await fetch(ZOHO_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(lead),
      });
      if (!res.ok) throw new Error(`Zoho responded ${res.status}`);
      console.log('Successfully sent to Zoho:', await res.json().catch(() => null));
      return true;
    } catch (err) {
      console.error('Error with Zoho request:', err);
      return false;
    }
  }

  async function sendToZapier(lead: LeadData): Promise<boolean> {
    try {
      const res = await fetch(ZAPIER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(lead).toString(),
      });
      if (!res.ok) throw new Error(`Zapier responded ${res.status}`);
      return true;
    } catch (err) {
      console.error('Error sending data to Zapier:', err);
      return false;
    }
  }

  function sendToSheet(name: string, phone: string) {
    const now = new Date();
    fetch(SHEET_URL, {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({
        data: [
          {
            name,
            phone,
            time: now.toLocaleTimeString(),
            date: now.toLocaleDateString(),
            url: location.href,
          },
        ],
      }),
    }).catch((err) => console.error('Error sending data to sheet:', err));
  }

  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector('[data-label]')!;
    const error = (key: string) => form.querySelector(`[data-error="${key}"]`)!;

    phone.addEventListener('input', () => {
      phone.value = phone.value.replace(/\D/g, '').slice(0, 10);
    });

    form.addEventListener('lead:reset', () => {
      if (form.querySelector('[data-success]')!.classList.contains('hidden')) return;
      form.reset();
      button.disabled = false;
      label.textContent = 'Submit';
      form.querySelector('[data-fields]')!.classList.remove('hidden');
      form.querySelector('[data-success]')!.classList.add('hidden');
    });

    const mark = (input: HTMLInputElement, key: string, invalid: boolean) => {
      if (invalid) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      error(key).classList.toggle('hidden', !invalid);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameOk = name.value.trim().length >= 2;
      const phoneOk = /^[6-9]\d{9}$/.test(phone.value);
      mark(name, 'name', !nameOk);
      mark(phone, 'phone', !phoneOk);
      if (!nameOk) return name.focus();
      if (!phoneOk) return phone.focus();

      const leadName = name.value.trim();
      const leadPhone = phone.value;
      const lead = buildLeadData(leadName, leadPhone);
      console.log('Lead data', lead);

      button.disabled = true;
      label.textContent = 'Submitting…';
      error('submit').classList.add('hidden');

      // Same flow as the old site: Zoho first, then Zapier either way; the sheet in parallel.
      sendToSheet(leadName, leadPhone);
      const zohoOk = await sendToZoho(lead);
      const zapierOk = await sendToZapier(lead);

      if (zohoOk || zapierOk) {
        (window as any).dataLayer?.push({ event: 'lead_submit', lead_source: form.dataset.source });
        form.querySelector('[data-fields]')!.classList.add('hidden');
        form.querySelector('[data-success]')!.classList.remove('hidden');
      } else {
        button.disabled = false;
        label.textContent = 'Submit';
        error('submit').classList.remove('hidden');
      }
    });
  });
</script>
