---
import { Image } from 'astro:assets';
import { ArrowUpRight, Droplet, Zap, Target, HeartPulse, Ribbon } from '@lucide/astro';
import type { Article, BlogCategory } from '../data/blog';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article: a, featured = false } = Astro.props;

// Generated cover art for posts that don't have a featured image yet.
const covers: Record<BlogCategory, { icon: typeof Droplet; bg: string }> = {
  Piles: { icon: Droplet, bg: 'from-brand-500 to-brand-700' },
  'Anal Fistula': { icon: Zap, bg: 'from-leaf-500 to-leaf-700' },
  Hernia: { icon: Target, bg: 'from-brand-700 to-brand-950' },
  Constipation: { icon: HeartPulse, bg: 'from-cyan-500 to-brand-600' },
  'Colorectal Cancer': { icon: Ribbon, bg: 'from-indigo-500 to-brand-800' },
};
const { icon: Icon, bg } = covers[a.category];
---

<a
  href={a.url}
  class:list={[
    'group flex h-full flex-col',
  ]}
>
  <div class:list={['relative isolate aspect-[3/2] overflow-hidden rounded-3xl bg-gradient-to-br shadow-lg shadow-brand-900/5', bg]}>
    {
      a.image ? (
        <Image
          src={a.image}
          alt=""
          widths={[400, 750]}
          sizes={featured ? '(min-width: 1024px) 40vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw'}
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      ) : (
        <>
          <div class="absolute inset-0 -z-10 opacity-30 [background-image:radial-gradient(white_1.2px,transparent_1.2px)] [background-size:18px_18px] [mask-image:linear-gradient(to_bottom_left,black,transparent_70%)]" />
          <div class="absolute -bottom-10 -right-10 h-48 w-48 rounded-full bg-white/10 transition duration-500 group-hover:scale-125" />
          <Icon class="absolute bottom-6 right-6 h-14 w-14 text-white/90 transition duration-500 group-hover:-rotate-12 group-hover:scale-110" stroke-width={1.5} />
        </>
      )
    }
    <span class="absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-brand-700 shadow-sm">
      {a.category}
    </span>
  </div>

  <div class="flex flex-1 flex-col pt-5">
    <h3 class:list={['font-bold leading-snug transition group-hover:text-brand-600', featured ? 'text-xl sm:text-2xl' : 'text-lg']}>
      {a.title}
    </h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{a.excerpt}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-600">
      Read article
      <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-50 transition group-hover:bg-brand-500 group-hover:text-white">
        <ArrowUpRight class="h-4 w-4 transition group-hover:rotate-45" />
      </span>
    </span>
  </div>
</a>
