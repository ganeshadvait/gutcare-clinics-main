---
import SectionHeading from './SectionHeading.astro';
import { PhoneCall, Stethoscope, Zap, House, CalendarCheck, ArrowRight } from '@lucide/astro';

const stages = [
  { icon: PhoneCall, when: 'Day 0', title: 'Reach out', text: 'Call, WhatsApp or leave your number. We call you back.' },
  { icon: Stethoscope, when: 'Consultation', title: 'Meet the specialist', text: 'Private examination and a written plan with cost.' },
  { icon: Zap, when: 'Procedure day', title: 'Day-care procedure', text: 'Laser / laparoscopic care, home the same day for most.' },
  { icon: House, when: 'Next few days', title: 'Recover at home', text: 'Simple diet chart and check-in calls from our team.' },
  { icon: CalendarCheck, when: 'Week 2+', title: 'Follow-up', text: 'One review visit and a plan to prevent recurrence.' },
];
---

<section id="journey" class="bg-brand-950 py-10 text-brand-100 sm:py-14">
  <div class="container-x">
    <SectionHeading
      dark
      eyebrow="Your Patient Journey"
      title="Your road back to a *healthy gut*"
      subtitle="Five simple steps from your first call to full recovery."
    />

    <div class="relative mt-10">
    <!-- Connecting line (desktop) -->
    <div class="absolute inset-x-[10%] top-7 hidden h-px bg-gradient-to-r from-brand-400/60 to-leaf-400/60 lg:block" aria-hidden="true"></div>
    <ol class="relative grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-5">
      {
        stages.map((s, i) => (
          <li class="relative flex gap-4 rounded-2xl bg-white/[0.06] p-5 ring-1 ring-white/10 lg:flex-col lg:items-center lg:bg-transparent lg:p-0 lg:text-center lg:ring-0">
            <span class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-900 text-leaf-300 ring-1 ring-white/15">
              <s.icon class="h-6 w-6" />
              <span class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-leaf-400 text-[10px] font-extrabold text-brand-950">{i + 1}</span>
            </span>
            <div>
              <p class="text-[11px] font-bold uppercase tracking-widest text-leaf-300">{s.when}</p>
              <h3 class="mt-1 text-base font-bold !text-white">{s.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-brand-200">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    </div>

    <div class="mt-10 text-center">
      <button type="button" class="btn btn-leaf" data-open-form="journey">
        Start your journey today <ArrowRight class="h-4 w-4" />
      </button>
    </div>
  </div>
</section>
