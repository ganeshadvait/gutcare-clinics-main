---
// Dr. Gehlot's portrait on the brand circle with floating credentials and name card.
// Shared by the home hero and the page heroes (doctor profile, treatment pages).
// On phones the badges are compact and hug the edges of the portrait so they don't cover the doctor.
import { Image } from 'astro:assets';
import { Award, BadgeCheck, Users } from '@lucide/astro';
import doctor from '../assets/doctors/dr-yuvraj-singh-gehlot.png';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const card =
  'portrait-float absolute z-10 flex items-center gap-1.5 rounded-lg bg-white px-2 py-1 shadow-lg shadow-slate-900/10 sm:gap-3 sm:rounded-2xl sm:px-5 sm:py-3.5 sm:shadow-xl';
const icon = 'h-4 w-4 shrink-0 sm:h-7 sm:w-7';
const value = 'text-xs font-bold text-slate-900 sm:text-base';
const label = 'text-[9px] text-slate-500 sm:text-xs';
---

<div class:list={['relative mx-auto w-full max-w-[560px] self-end', className]}>
  <div class="relative mx-auto w-[74%]">
    <div class="absolute inset-x-0 bottom-0 aspect-square" aria-hidden="true">
      <div class="absolute -inset-[7%] rounded-full border border-brand-200"></div>
      <div class="absolute inset-0 rounded-full bg-gradient-to-br from-brand-500 to-brand-600"></div>
    </div>
    <div class="relative">
      <Image
        src={doctor}
        alt="Dr. Yuvraj Singh Gehlot, gastrointestinal and colorectal surgeon at GutCare Clinics"
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 640px) 360px, 64vw"
        class="mx-auto block h-auto w-[86%]"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- Floating credentials -->
  <div class:list={[card, 'right-[calc(87%-77px)] top-[22%] sm:left-[2%] sm:right-auto sm:top-[24%]']}>
    <Award class:list={[icon, 'text-leaf-500']} />
    <div class="leading-tight">
      <p class={value}>30+ Years</p>
      <p class={label}>in healthcare</p>
    </div>
  </div>
  <div class:list={[card, 'left-[calc(87%-84px)] top-[36%] [animation-delay:-2s] sm:left-auto sm:right-0 sm:top-[38%]']}>
    <BadgeCheck class:list={[icon, 'text-brand-500']} />
    <div class="leading-tight">
      <p class={value}>25,000+</p>
      <p class={label}>surgeries performed</p>
    </div>
  </div>
  <div class:list={[card, 'left-[calc(87%-65px)] top-[60%] [animation-delay:-3s] sm:left-auto sm:right-[2%] sm:top-[62%]']}>
    <Users class:list={[icon, 'text-leaf-500']} />
    <div class="leading-tight">
      <p class={value}>1,00,000+</p>
      <p class={label}>patients treated</p>
    </div>
  </div>
  <div class="portrait-float absolute right-[calc(87%-80px)] top-[48%] z-10 flex items-center gap-1 rounded-full bg-white px-2 py-1 text-[10px] font-semibold text-slate-900 shadow-xl shadow-slate-900/10 [animation-delay:-4s] sm:left-0 sm:right-auto sm:top-[56%] sm:gap-2 sm:px-5 sm:py-2.5 sm:text-sm">
    <BadgeCheck class="h-3 w-3 shrink-0 text-leaf-500 sm:h-4 sm:w-4" />
    98% Success Rate
  </div>

  <!-- Name card -->
  <div class="absolute bottom-4 left-1/2 z-10 w-[94%] -translate-x-1/2 rounded-xl bg-white px-3 py-2 text-center shadow-xl shadow-slate-900/10 sm:bottom-6 sm:w-[72%] sm:min-w-max sm:max-w-[95%] sm:rounded-2xl sm:px-6 sm:py-3.5">
    <p class="text-sm font-bold text-slate-900 sm:text-lg">Dr. Yuvraj Singh Gehlot</p>
    <p class="text-[10px] text-brand-700 sm:text-sm">Senior GI, Laparoscopic &amp; Colorectal Surgeon</p>
  </div>
</div>

<style>
  .portrait-float {
    animation: portrait-float 6s ease-in-out infinite;
  }
  @keyframes portrait-float {
    50% { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-float { animation: none; }
  }
</style>
