---
import { Image } from 'astro:assets';
import { X, CircleCheck, Phone } from '@lucide/astro';
import LeadForm from './LeadForm.astro';
import doctor from '../assets/doctors/dr-yuvraj-singh-gehlot.jpeg';
import { site } from '../data/site';

const perks = ['Free first consultation call', 'Laser & laparoscopic experts', 'Transparent pricing & insurance help'];
---

<dialog
  id="lead-modal"
  aria-labelledby="lead-modal-title"
  class="lead-modal m-auto w-[calc(100%-2rem)] max-w-3xl overflow-visible bg-transparent p-0 backdrop:bg-brand-950/60 backdrop:backdrop-blur-sm"
>
  <div class="relative grid overflow-hidden rounded-3xl bg-white shadow-2xl md:grid-cols-[0.9fr_1fr]">
    <button
      type="button"
      class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-500 shadow ring-1 ring-slate-100 hover:text-slate-900"
      aria-label="Close"
      data-close-modal
    >
      <X class="h-5 w-5" />
    </button>

    <div class="relative hidden overflow-hidden bg-[#efeee6] md:block">
      <Image
        src={doctor}
        alt="Dr. Yuvraj Singh Gehlot, GutCare Clinics"
        widths={[400, 700]}
        sizes="360px"
        class="h-full w-full origin-top scale-[1.3] object-cover object-top"
        loading="lazy"
      />
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-950/95 via-brand-950/70 to-transparent p-6 pt-24">
        <ul class="space-y-2">
          {
            perks.map((p) => (
              <li class="flex items-center gap-2 text-sm font-medium text-white">
                <CircleCheck class="h-4 w-4 shrink-0 text-leaf-300" /> {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="max-h-[85dvh] overflow-y-auto [&_.lead-form]:shadow-none [&_.lead-form]:ring-0">
      <LeadForm
        source="popup"
        titleId="lead-modal-title"
        title="Book Your Free Consultation"
        subtitle="Leave your details. Our care coordinator will call you back shortly."
        withTreatment
      />
      <p class="-mt-2 px-6 pb-6 text-center text-xs text-slate-500 sm:px-8">
        Prefer to talk now? <a href={site.phoneHref} class="inline-flex items-center gap-1 font-semibold text-brand-600"><Phone class="h-3 w-3" />{site.phone}</a>
      </p>
    </div>
  </div>
</dialog>

<style>
  .lead-modal[open] {
    animation: modal-in 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }
  .lead-modal[open]::backdrop {
    animation: backdrop-in 0.3s ease-out;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes backdrop-in {
    from { opacity: 0; }
  }
  :global(html:has(.lead-modal[open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .lead-modal[open], .lead-modal[open]::backdrop { animation: none; }
  }
</style>

<script>
  const modal = document.getElementById('lead-modal') as HTMLDialogElement | null;
  const form = modal?.querySelector<HTMLFormElement>('form.lead-form');

  if (modal && form) {
    // Any element with data-open-form opens the popup; data-open-form="<cta name>" is recorded as the lead source.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>('[data-open-form]');
      if (!trigger) return;
      e.preventDefault();
      form.dataset.source = trigger.dataset.openForm || 'popup';
      const select = form.elements.namedItem('treatment') as HTMLSelectElement | null;
      if (select && trigger.dataset.treatment) select.value = trigger.dataset.treatment;
      modal.showModal();
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });

    modal.querySelector('[data-close-modal]')?.addEventListener('click', () => modal.close());
    // Click on the backdrop (the dialog element itself, outside the card) closes it.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    modal.addEventListener('close', () => form.dispatchEvent(new Event('lead:reset')));
  }
</script>
