---
import { Star, Quote } from '@lucide/astro';
import type { Review } from '../data/reviews';

interface Props {
  review: Review;
}

const { review: r } = Astro.props;
const initials = r.name
  .split(/\s+/)
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<figure class="relative flex h-full flex-col rounded-3xl bg-white p-6 ring-2 ring-brand-200 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/5 hover:ring-brand-400">
  <div class="flex items-center justify-between gap-3">
    <div class="flex gap-0.5 text-amber-400" aria-label={`${r.rating} out of 5 stars`}>
      {Array.from({ length: 5 }, (_, i) => <Star class:list={['h-4 w-4', i < r.rating && 'fill-current']} />)}
    </div>
    <Quote class="h-7 w-7 text-brand-100" />
  </div>
  {r.condition && <span class="mt-4 self-start rounded-full bg-leaf-50 px-2.5 py-1 text-[11px] font-bold text-leaf-700">{r.condition}</span>}
  <blockquote class="mt-3 line-clamp-5 flex-1 text-[15px] leading-relaxed text-slate-700">{r.text}</blockquote>
  <figcaption class="mt-5 flex items-center gap-3 border-t border-slate-100 pt-4">
    {
      r.photo ? (
        <img src={r.photo} alt="" class="h-10 w-10 rounded-full object-cover" loading="lazy" referrerpolicy="no-referrer" />
      ) : (
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-bold text-white">{initials}</span>
      )
    }
    <div class="min-w-0">
      <p class="truncate text-sm font-bold text-slate-900">
        {r.url ? <a href={r.url} target="_blank" rel="noopener" class="hover:underline">{r.name}</a> : r.name}
      </p>
      <p class="text-xs text-slate-500">{[r.when, r.source && `via ${r.source}`].filter(Boolean).join(' · ')}</p>
    </div>
  </figcaption>
</figure>
