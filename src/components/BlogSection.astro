---
import SectionHeading from './SectionHeading.astro';
import { ArrowRight } from '@lucide/astro';
import BlogCard from './BlogCard.astro';
import { articles } from '../data/blog';

const latest = articles.slice(0, 3);
---

<section id="blog" class="py-10 sm:py-14">
  <div class="container-x">
    <SectionHeading
      eyebrow="Gut Health Library"
      title="Learn from *our specialists*"
      subtitle="Clear, doctor-written guides on symptoms, causes and modern treatment options."
    />

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((a, i) => <div class:list={[i === 2 && 'md:hidden lg:block']}><BlogCard article={a} /></div>)}
    </div>

    <div class="mt-10 text-center">
      <a href="/blog/" class="btn btn-primary">View more blogs <ArrowRight class="h-4 w-4" /></a>
    </div>
  </div>
</section>
