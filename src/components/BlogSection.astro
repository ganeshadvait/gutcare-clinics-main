---
import SectionHeading from './SectionHeading.astro';
import { ArrowRight } from '@lucide/astro';
import BlogCard from './BlogCard.astro';
import { cacheHeaders, getPosts } from '../lib/wordpress';

// Used as a server island on the home page (server:defer), so the latest posts show without a rebuild.
const latest = (await getPosts({ perPage: 3 }).catch(() => null))?.posts ?? [];
cacheHeaders(Astro.response.headers);
---

<section id="blog" class="py-10 sm:py-14">
  <div class="container-x">
    <SectionHeading
      title="Learn from *our specialists*"
      subtitle="Clear, doctor-written guides on symptoms, causes and treatment options for piles, fistula, hernia and other digestive conditions."
    />

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((a, i) => <div class:list={[i === 2 && 'md:hidden lg:block']}><BlogCard post={a} /></div>)}
    </div>

    <div class="mt-10 text-center">
      <a href="/blog/" class="btn btn-primary">View more blogs <ArrowRight class="h-4 w-4" /></a>
    </div>
  </div>
</section>
