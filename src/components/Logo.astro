---
// Vector recreation of the GutCare mark. Swap for the official logo file
// (e.g. <img src="/images/logo.svg">) when available.
interface Props {
  class?: string;
  light?: boolean;
}
const { class: className = '', light = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg viewBox="0 0 48 48" class="h-10 w-10 shrink-0" aria-hidden="true">
    <path
      d="M30 4c-1 5-4 8-4 13 0 6 7 6 9 12 2 7-3 14-11 14-6 0-10-3-14-7l-6 4"
      fill="none"
      stroke="#2590d3"
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path d="M30 4c3 3 5 6 4 10" fill="none" stroke="#7fc64a" stroke-width="3" stroke-linecap="round"></path>
    <circle cx="27" cy="25" r="1.8" fill="#7fc64a"></circle>
    <circle cx="31" cy="30" r="1.4" fill="#2590d3"></circle>
    <circle cx="24" cy="31" r="1.6" fill="#7fc64a"></circle>
    <circle cx="28" cy="35" r="1.2" fill="#7fc64a"></circle>
    <circle cx="21" cy="26" r="1.1" fill="#2590d3"></circle>
    <circle cx="19" cy="35" r="1.3" fill="#2590d3"></circle>
  </svg>
  <span class="text-2xl font-extrabold italic leading-none tracking-tight">
    <span class={light ? 'text-brand-300' : 'text-brand-500'}>Gut</span><span class="text-leaf-400">Care</span>
  </span>
  <span class="sr-only">Clinics</span>
</span>
