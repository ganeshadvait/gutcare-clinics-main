---
import { Image } from 'astro:assets';
import logo from '../assets/gutcare-logo.webp';

interface Props {
  class?: string;
  light?: boolean;
}
const { class: className = '', light = false } = Astro.props;
---

<span class:list={['inline-flex items-center', light && 'rounded-xl bg-white px-3 py-1.5', className]}>
  <Image src={logo} alt="GutCare Clinics" width={320} class="h-11 w-auto" loading="eager" />
</span>
