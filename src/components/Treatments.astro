---
import SectionHeading from './SectionHeading.astro';
import { Droplet, Zap, Sparkles, Target, Microscope, Ambulance, Flame, HeartPulse, Ribbon, ArrowRight } from '@lucide/astro';
import { treatments } from '../data/site';

const icons = {
  piles: Droplet,
  fistula: Zap,
  fissure: Sparkles,
  hernia: Target,
  gallbladder: Microscope,
  appendix: Ambulance,
  reflux: Flame,
  constipation: HeartPulse,
  cancer: Ribbon,
} as const;
---

<section id="treatments" class="py-10 sm:py-14">
  <div class="container-x">
    <SectionHeading
      eyebrow="Our Treatments"
      title="Specialised care for every *gut & colorectal* concern"
      subtitle="Minimally invasive, evidence-based procedures designed for less pain, smaller scars and a faster return to everyday life."
    />

    <ul class="mt-10 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        treatments.map((t) => {
          const Icon = icons[t.icon as keyof typeof icons];
          return (
            <li class="border-t border-slate-200">
              <a href={`/${t.slug}/`} class="group flex gap-5 py-7">
                <Icon class="mt-1 h-7 w-7 shrink-0 text-brand-500 transition group-hover:text-leaf-500" stroke-width={1.75} />
                <span class="flex-1">
                  <span class="flex items-center justify-between gap-3">
                    <span class="text-lg font-bold text-slate-900 transition group-hover:text-brand-600">{t.name}</span>
                    <ArrowRight class="h-4 w-4 shrink-0 -translate-x-1 text-brand-500 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100" />
                  </span>
                  <span class="mt-1.5 block text-sm leading-relaxed text-slate-600">{t.blurb}</span>
                  <span class="mt-3 block text-xs font-semibold text-leaf-600">{t.tags.join(' · ')}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
