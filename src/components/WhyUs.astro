---
import SectionHeading from './SectionHeading.astro';
import { X, Check, Zap, Ambulance, BadgeIndianRupee, Plane, HeartHandshake, ArrowRight } from '@lucide/astro';

// Typical differences; individual results vary with the condition and procedure.
const comparison = [
  { label: 'Incision', old: 'Large cuts', now: 'Keyhole or no cuts' },
  { label: 'Pain', old: 'Significant post-op pain', now: 'Minimal discomfort' },
  { label: 'Hospital stay', old: 'Often several days', now: 'Same-day discharge*' },
  { label: 'Back to routine', old: 'Weeks', now: 'Within days' },
  { label: 'Scarring', old: 'Visible scars', now: 'Minimal to none' },
];

const reasons = [
  { icon: Zap, title: 'USFDA-approved laser', text: 'Precise treatment with minimal bleeding.' },
  { icon: Ambulance, title: '24x7 emergency', text: 'Round-the-clock support when you need it.' },
  { icon: BadgeIndianRupee, title: 'Transparent pricing', text: 'Clear estimates and insurance help.' },
  { icon: HeartHandshake, title: 'Personalised care', text: 'A plan built around your diagnosis.' },
  { icon: Plane, title: 'Global patients', text: 'Trusted by patients from across India and abroad.' },
];
---

<section id="why-gutcare" class="bg-brand-50/50 py-10 sm:py-14">
  <div class="container-x">
    <SectionHeading
      eyebrow="Why GutCare"
      title="Modern treatment that’s *gentler on you*"
      subtitle="See how advanced laser and laparoscopic care compares with conventional open surgery."
    />

    <!-- Comparison -->
    <div class="mx-auto mt-10 max-w-4xl">
      <div class="grid grid-cols-[1fr_1fr_1.15fr] items-end gap-x-2 pb-3 sm:gap-x-6">
        <span></span>
        <span class="text-center text-xs font-semibold text-slate-400 sm:text-sm">Conventional surgery</span>
        <span class="text-center text-xs font-extrabold text-leaf-600 sm:text-sm">GutCare advanced care</span>
      </div>
      <ul class="relative">
        <!-- Tinted band behind the GutCare column -->
        <li class="pointer-events-none absolute inset-y-0 right-0 w-[35%] rounded-2xl bg-leaf-100/60" aria-hidden="true"></li>
        {
          comparison.map((row) => (
            <li class="relative grid grid-cols-[1fr_1fr_1.15fr] items-center gap-x-2 border-t border-slate-200/80 py-4 sm:gap-x-6">
              <span class="text-sm font-bold text-slate-800 sm:text-base">{row.label}</span>
              <span class="flex items-center justify-center gap-1.5 text-center text-xs text-slate-400 sm:text-sm">
                <X class="hidden h-4 w-4 shrink-0 text-red-300 sm:block" /> {row.old}
              </span>
              <span class="flex items-center justify-center gap-1.5 text-center text-xs font-semibold text-leaf-700 sm:text-sm">
                <Check class="hidden h-4 w-4 shrink-0 text-leaf-500 sm:block" /> {row.now}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-xs text-slate-500">*For most laser procedures. Your surgeon will advise based on your diagnosis.</p>
        <button type="button" class="btn btn-leaf shrink-0" data-open-form="why-us">
          Book a consultation <ArrowRight class="h-4 w-4" />
        </button>
      </div>
    </div>

    <!-- Reasons -->
    <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 border-t border-slate-200/80 pt-8 lg:grid-cols-5 lg:gap-6">
      {
        reasons.map(({ icon: Icon, title, text }) => (
          <li class="text-center last:col-span-2 lg:last:col-span-1">
            <Icon class="mx-auto h-8 w-8 text-brand-500" stroke-width={1.6} />
            <h3 class="mt-4 font-bold text-slate-900">{title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
