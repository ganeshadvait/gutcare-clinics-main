---
import { Image } from 'astro:assets';
import { Phone, ArrowRight, Clock, Zap, ShieldCheck } from '@lucide/astro';
import doctor from '../assets/doctors/dr-yuvraj-singh-gehlot.jpeg';
import { site } from '../data/site';

const chips = [
  { icon: Zap, label: '~30 min laser procedures' },
  { icon: Clock, label: 'Same-day discharge' },
  { icon: ShieldCheck, label: 'Insurance assistance' },
];
---

<section class="py-8 sm:py-12">
  <div class="container-x">
    <div class="relative isolate overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-500 via-brand-600 to-brand-800 px-6 py-10 sm:px-12 sm:py-14 lg:py-0">
      <div class="absolute -left-24 -top-24 -z-10 h-80 w-80 rounded-full border-[40px] border-white/5"></div>
      <div class="absolute -bottom-32 left-1/3 -z-10 h-96 w-96 rounded-full border-[50px] border-leaf-400/10"></div>
      <div class="absolute inset-0 -z-10 opacity-20 [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_right,black,transparent_60%)]"></div>

      <div class="grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div class="lg:py-14">
          <p class="text-sm font-bold uppercase tracking-widest text-leaf-300">Piles · Fistula · Fissure · Hernia</p>
          <h2 class="mt-3 text-3xl font-extrabold leading-tight !text-white sm:text-4xl lg:text-5xl">
            Don’t let embarrassment delay your relief.
          </h2>
          <p class="mt-4 max-w-xl text-brand-100">
            Talk to a specialist in complete confidence. Most conditions are easier to treat when caught early.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              chips.map(({ icon: Icon, label }) => (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-semibold text-white ring-1 ring-white/15">
                  <Icon class="h-3.5 w-3.5 text-leaf-300" /> {label}
                </li>
              ))
            }
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <button type="button" class="btn bg-white text-brand-700 shadow-xl hover:bg-brand-50" data-open-form="cta-banner">
              Book a consultation <ArrowRight class="h-4 w-4" />
            </button>
            <a href={site.phoneHref} class="btn border border-white/30 text-white hover:bg-white/10">
              <Phone class="h-4 w-4" /> {site.phone}
            </a>
          </div>
        </div>

        <div class="relative mx-auto w-64 sm:w-80 lg:mr-0 lg:w-full lg:self-end">
          <div class="absolute inset-x-6 bottom-0 top-10 -z-10 rounded-t-full bg-white/15"></div>
          <div class="overflow-hidden rounded-t-full [mask-image:linear-gradient(to_bottom,black_80%,transparent)]">
            <Image
              src={doctor}
              alt="Dr. Yuvraj Singh Gehlot"
              widths={[320, 640]}
              sizes="(min-width: 1024px) 400px, 320px"
              class="aspect-[8/7] w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
