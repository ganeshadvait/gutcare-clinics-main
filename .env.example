# Optional: endpoint that receives hero/contact form submissions as JSON { name, phone, treatment, source }.
# e.g. a CRM webhook, Google Apps Script URL, Formspree, Zapier, etc.
# If unset, the form falls back to opening WhatsApp with the details pre-filled.
PUBLIC_LEAD_ENDPOINT=

# Optional: show the live Google rating + latest reviews (fetched at build time via Places API (New)).
# Find the Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
