# WordPress install the blog posts come from (no trailing slash). Defaults to https://www.gutcareclinics.com.
# Set to the CMS subdomain (e.g. https://cms.gutcareclinics.com) once this site serves www.gutcareclinics.com.
WORDPRESS_URL=

# Optional: show the live Google rating + latest reviews (fetched at build time via Places API (New)).
# Find the Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
